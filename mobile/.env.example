# Copy this file to .env and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard). The anon key is safe
# to ship in the app bundle — every table it can reach is behind Row Level
# Security (supabase/migrations/). Never put the service_role key here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
