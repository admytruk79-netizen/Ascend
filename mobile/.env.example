# Copy this file to .env and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard). The anon key is safe
# to ship in the app bundle — every table it can reach is behind Row Level
# Security (supabase/migrations/). Never put the service_role key here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (from the RevenueCat dashboard > Project
# Settings > API Keys). These are meant to ship in the client, unlike the
# Supabase service_role key — RevenueCat's public keys can only start a
# purchase flow, not access account data.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
